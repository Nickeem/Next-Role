# Copy to .env and adjust. Never commit .env.

# --- Docker Compose (database container) ---
POSTGRES_USER=next_role
POSTGRES_PASSWORD=change-me
POSTGRES_DB=next_role
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000

# --- Application ---
NEXT_ROLE_ENVIRONMENT=development
NEXT_ROLE_LOG_LEVEL=INFO
NEXT_ROLE_LOG_JSON=true
# Used when running the app/migrations directly on the host. Docker Compose overrides it.
NEXT_ROLE_DATABASE_URL=postgresql+psycopg://next_role:change-me@localhost:5432/next_role

# Shared-secret API key, sent as the X-API-Key header. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXT_ROLE_API_KEY=replace-with-a-long-random-value
# Local experimentation only: disables API-key checks entirely.
NEXT_ROLE_AUTH_DISABLED=false

# Password for the web workspace (at least 12 characters). Unset disables browser login;
# the API key keeps working for scripts. Sessions last NEXT_ROLE_SESSION_TTL_HOURS.
# NEXT_ROLE_UI_PASSWORD=
# NEXT_ROLE_SESSION_TTL_HOURS=12
# Keep true unless the app is served over plain http on a host other than localhost.
# NEXT_ROLE_SESSION_COOKIE_SECURE=true

# Maximum accepted job description length (characters).
NEXT_ROLE_MAX_JOB_DESCRIPTION_CHARS=50000

# --- Optional LLM-assisted requirement extraction ---
# none (default): fully deterministic, rule-based extraction; no data leaves the server.
# ollama: self-hosted Ollama (e.g. NEXT_ROLE_LLM_BASE_URL=http://host.docker.internal:11434).
# openai_compatible: any /v1/chat/completions endpoint; requires NEXT_ROLE_LLM_ALLOW_EXTERNAL=true
#   because job description text is sent to that provider.
NEXT_ROLE_LLM_PROVIDER=none
# NEXT_ROLE_LLM_BASE_URL=http://localhost:11434
# NEXT_ROLE_LLM_MODEL=llama3.1:8b
# NEXT_ROLE_LLM_API_KEY=
# NEXT_ROLE_LLM_TIMEOUT_SECONDS=60
# NEXT_ROLE_LLM_ALLOW_EXTERNAL=false
# Document drafting (Phase 3) sends selected candidate facts and the job text to the provider.
# Required for every provider, including Ollama; without it, documents are assembled
# deterministically from your facts and nothing about you is sent to a model (ADR 0006).
# NEXT_ROLE_LLM_ALLOW_CANDIDATE_DATA=false

# --- Generated documents ---
# Where rendered PDF/DOCX files are stored. Docker Compose fixes this to the `artifacts`
# volume's mount point; set it only when running outside Compose. Back it up with the database.
# NEXT_ROLE_ARTIFACT_DIR=/var/lib/next-role/artifacts
# NEXT_ROLE_GENERATION_MAX_ATTEMPTS=3
# NEXT_ROLE_GENERATION_LEASE_SECONDS=600
# Renderer: time limit per file, and where the built print page lives in the renderer image.
# NEXT_ROLE_RENDER_TIMEOUT_SECONDS=30
# NEXT_ROLE_PRINT_BUNDLE_DIR=/app/print

# --- Notifications (ntfy) ---
# Published by the worker service to your existing ntfy server. See docs/operations/ntfy.md.
# Messages contain no job, employer, score, or candidate details.
NEXT_ROLE_NTFY_ENABLED=false
# NEXT_ROLE_NTFY_BASE_URL=https://ntfy.example.internal
# NEXT_ROLE_NTFY_TOPIC=resume-review
# A token for a user with write-only access to the topic. Never commit it.
# NEXT_ROLE_NTFY_TOKEN=
# Plain http is refused unless enabled (only for a private network, e.g. http://ntfy:80).
# NEXT_ROLE_NTFY_ALLOW_HTTP=false
# NEXT_ROLE_NTFY_TIMEOUT_SECONDS=10
# Link target for notifications; the app requires login. Omit to send messages without links.
# NEXT_ROLE_PUBLIC_BASE_URL=https://resume.example.internal
# NEXT_ROLE_NOTIFICATION_MAX_ATTEMPTS=8
# NEXT_ROLE_NOTIFICATION_MAX_AGE_HOURS=24
# NEXT_ROLE_WORKER_POLL_SECONDS=10
